DATA.cats.forEach((c,i) => steps.push({type:"cat", i:i}));
steps.push({type:"exception"});
steps.push({type:"money"});
steps.push({type:"ask"});
steps.push({type:"same"});
steps.push({type:"done"});

const view = document.getElementById("view");
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function choiceRow(key, val, cb){
  const wrap = document.createElement("div");
  wrap.className = "choices";
  [["y","可以"],["n","不行"],["?","我不確定"]].forEach(([v,label]) => {
    const b = document.createElement("button");
    b.dataset.v = v; b.textContent = label;
    if (val === v) b.classList.add("on");
    b.onclick = () => { cb(v); save(); wrap.querySelectorAll("button").forEach(x => x.classList.remove("on")); b.classList.add("on"); };
    wrap.appendChild(b);
  });
  return wrap;
}

function render(){
  const s = steps[step];
  view.innerHTML = "";
  window.scrollTo(0,0);
  document.getElementById("prev").disabled = (step === 0);
  document.getElementById("next").textContent = step === 0 ? "開始填寫" : (s.type === "done" ? "回到上一頁" : "下一頁");
  document.getElementById("next").style.visibility = s.type === "done" ? "hidden" : "visible";
  const pct = Math.round(step / (steps.length - 1) * 100);
  document.getElementById("fill").style.width = pct + "%";
  document.getElementById("pct").textContent = pct + "%";
  document.getElementById("stepno").textContent =
    s.type === "cat" ? ("第 " + (s.i+1) + " / " + DATA.cats.length + " 類") :
    s.type === "intro" ? "說明" : s.type === "done" ? "完成" : "補充";

  if (s.type === "intro") return renderIntro();
  if (s.type === "cat") return renderCat(s.i);
  if (s.type === "exception") return renderException();
  if (s.type === "money") return renderMoney();
  if (s.type === "ask") return renderAsk();
  if (s.type === "same") return renderSame();
  if (s.type === "done") return renderDone();
}

function renderIntro(){
  view.innerHTML = `
    <h2>老闆好，這份要問的是：<br>「哪些菜可以讓客人加註記？」</h2>
    <p class="lead">您 POS 裡有 62 個先結註記（大辣、加飯$20、X薑絲…），
    新系統需要知道每一道菜各能用哪些。全部用按的，不用打字，大約 10 分鐘。</p>
    <div class="card">
      <h3>會怎麼問</h3>
      <p class="egs">一次問一整類（例如「湯系列」16 道），問 8 個問題，
      每題按「可以 / 不行 / 我不確定」。不確定就按不確定，我們再一起看，不用猜。</p>
      <p class="egs">整類問完後，才會問「有沒有哪一道特別不一樣」。</p>
    </div>
    <div class="hint">填到一半可以放著。答案會自動存在這支手機裡，關掉再打開會回到原本的地方。<br>
    換手機或換人填，才需要用最後一頁的「存成檔案」，再從下面讀回來。</div>
    <div class="card">
      <h3>接續上次的進度</h3>
      <label class="file">選擇上次存的檔案：<input type="file" id="load" accept=".json"></label>
    </div>`;
  document.getElementById("load").onchange = e => {
    const f = e.target.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      try {
        const d = JSON.parse(r.result);
        Object.assign(A, d.answers || d);
        alert("已讀回上次的進度，繼續填就好。");
      } catch(err){ alert("這個檔案讀不出來，請確認是之前存的 .json 檔。"); }
    };
    r.readAsText(f);
  };
}

function renderCat(i){
  const c = DATA.cats[i];
  A.cat[c.name] = A.cat[c.name] || {};
  const names = c.items.map(x => x.name);
  const shown = names.slice(0,8).join("、") + (names.length > 8 ? " …等 " + names.length + " 樣" : "");
  view.insertAdjacentHTML("beforeend", `
    <h2>${esc(c.name)}</h2>
    <div class="ticket"><div class="cap">這一類包含</div><div class="list">${esc(shown)}</div></div>`);
  DATA.groups.forEach(g => {
    const card = document.createElement("div");
    card.className = "card";
    card.innerHTML = `<h3>${esc(g.q)}</h3><p class="egs">${esc(g.egs)}</p>`;
    card.appendChild(choiceRow(g.id, A.cat[c.name][g.id], v => { A.cat[c.name][g.id] = v; }));
    view.appendChild(card);
  });
}

function renderException(){
  view.insertAdjacentHTML("beforeend", `
    <h2>有沒有哪一道特別不一樣？</h2>
    <p class="lead">剛才是整類一起回答。如果某一道菜跟同類不同（例如只有它不能加麵），
    在這裡挑出來單獨設定。<b>沒有的話直接按下一頁</b>，這頁可以跳過。</p>`);
  DATA.cats.forEach((c, ci) => {
    const btn = document.createElement("button");
    btn.className = "catbtn";
    btn.textContent = "▸ " + c.name + "（" + c.items.length + " 樣）";
    const box = document.createElement("div");
    box.style.display = "none";
    btn.onclick = () => {
      const open = box.style.display === "block";
      box.style.display = open ? "none" : "block";
      btn.textContent = (open ? "▸ " : "▾ ") + c.name + "（" + c.items.length + " 樣）";
    };
    c.items.forEach(it => {
      const row = document.createElement("div");
      row.className = "itemrow";
      row.innerHTML = `<span class="nm">${esc(it.name)}<span style="color:var(--muted);font-size:15px"> $${it.price}</span></span>`;
      const t = document.createElement("button");
      t.className = "toggle" + (A.item[it.code] ? " on" : "");
      t.textContent = A.item[it.code] ? "不一樣 ✓" : "跟同類不同";
      const sub = document.createElement("div");
      sub.className = "sub";
      sub.style.display = A.item[it.code] ? "block" : "none";
      function buildSub(){
        sub.innerHTML = `<div style="font-size:15px;color:var(--muted)">「${esc(it.name)}」單獨設定：</div>`;
        DATA.groups.forEach(g => {
          const q = document.createElement("div");
          q.className = "q"; q.textContent = g.q;
          sub.appendChild(q);
          sub.appendChild(choiceRow(g.id, (A.item[it.code]||{})[g.id], v => { A.item[it.code][g.id] = v; }));
        });
      }
      t.onclick = () => {
        if (A.item[it.code]) { delete A.item[it.code]; t.classList.remove("on"); t.textContent = "跟同類不同"; sub.style.display = "none"; }
        else { A.item[it.code] = Object.assign({}, A.cat[c.name] || {}); t.classList.add("on"); t.textContent = "不一樣 ✓"; buildSub(); sub.style.display = "block"; }
        save();
      };
      if (A.item[it.code]) buildSub();
      row.appendChild(t);
      box.appendChild(row);
      box.appendChild(sub);
    });
    view.appendChild(btn);
    view.appendChild(box);
  });
}

function renderMoney(){
  view.insertAdjacentHTML("beforeend", `
    <h2>這幾個要收多少錢？</h2>
    <p class="lead">免費的請填 0。不提供這個選項就填空白，我們會刪掉。</p>`);
  const card = document.createElement("div");
  card.className = "card";
  DATA.money.forEach(m => {
    const row = document.createElement("div");
    row.className = "money";
    row.innerHTML = `<span class="nm">${esc(m.name)}</span>`;
    const inp = document.createElement("input");
    inp.type = "number"; inp.inputMode = "numeric"; inp.min = 0;
    inp.value = (A.money[m.code] === "" || A.money[m.code] == null) ? "" : A.money[m.code];
    inp.oninput = () => { A.money[m.code] = inp.value === "" ? "" : Number(inp.value); save(); };
    row.appendChild(inp);
    row.insertAdjacentHTML("beforeend", `<span class="yuan">元</span>`);
    card.appendChild(row);
  });
  view.appendChild(card);
}

function renderAsk(){
  view.insertAdjacentHTML("beforeend", `
    <h2>這幾個註記我看不懂</h2>
    <p class="lead">POS 裡有幾個簡寫，麻煩用一句話說明用途。用不到的就寫「不用了」。</p>`);
  DATA.ask.forEach(q => {
    const card = document.createElement("div");
    card.className = "card";
    card.innerHTML = `<h3>${esc(q.q)}</h3>`;
    const inp = document.createElement("input");
    inp.type = "text"; inp.placeholder = "例如：湯不夠時免費加湯";
    inp.value = A.ask[q.code] || "";
    inp.oninput = () => { A.ask[q.code] = inp.value; save(); };
    card.appendChild(inp);
    view.appendChild(card);
  });
  const last = document.createElement("div");
  last.className = "card";
  last.innerHTML = `<h3>還有什麼要補充的嗎？</h3>
    <p class="egs">例如：內用外帶價格不同、外送平台的選項不一樣、某些菜停售了。</p>`;
  const ta = document.createElement("textarea");
  ta.value = A.note; ta.placeholder = "沒有的話留空白就好";
  ta.oninput = () => { A.note = ta.value; save(); };
  last.appendChild(ta);
  view.appendChild(last);
}

function renderSame(){
  view.insertAdjacentHTML("beforeend", `
    <h2>這幾組是同一個意思嗎？</h2>
    <p class="lead">POS 裡有兩個寫法很像的註記。如果是同一件事，我們合併成一個，客人點餐時比較不會選錯。</p>`);
  DATA.same.forEach((p, i) => {
    const card = document.createElement("div");
    card.className = "card";
    card.innerHTML = `<h3>${esc(p.a)}　和　${esc(p.b)}</h3>`;
    const wrap = document.createElement("div");
    wrap.className = "choices";
    [["merge","一樣，合併"],["keep","不一樣，都留"],["?","我不確定"]].forEach(([v,label]) => {
      const b = document.createElement("button");
      b.dataset.v = v === "merge" ? "y" : (v === "keep" ? "n" : "?");
      b.textContent = label;
      if (A.same[i] === v) b.classList.add("on");
      b.onclick = () => { A.same[i] = v; save(); wrap.querySelectorAll("button").forEach(x => x.classList.remove("on")); b.classList.add("on"); };
      wrap.appendChild(b);
    });
    card.appendChild(wrap);
    view.appendChild(card);
  });
}

/* 一行短碼：讓「貼到 LINE 的純文字」也能精準還原成 POS 代號，不必靠檔案 */
function code(){
  const m = v => v === "y" ? "y" : v === "n" ? "n" : v === "?" ? "?" : "-";
  const cat = DATA.cats.map(c => DATA.groups.map(g => m((A.cat[c.name]||{})[g.id])).join("")).join(",");
  const item = Object.keys(A.item).map(k => k + ":" + DATA.groups.map(g => m(A.item[k][g.id])).join("")).join(",");
  const money = DATA.money.map(x => (A.money[x.code] === "" || A.money[x.code] == null) ? "" : A.money[x.code]).join(",");
  const same = DATA.same.map((x,i) => A.same[i] === "merge" ? "m" : A.same[i] === "keep" ? "k" : A.same[i] === "?" ? "?" : "-").join("");
  return "#DATA|v1|CAT=" + cat + "|ITEM=" + item + "|MONEY=" + money + "|SAME=" + same;
}

function summary(){
  const L = [];
  L.push("【文章牛肉湯 點餐選項確認單】");
  L.push("");
  L.push("■ 各類別可用的選項");
  DATA.cats.forEach(c => {
    const a = A.cat[c.name] || {};
    const y = DATA.groups.filter(g => a[g.id] === "y").map(g => g.name);
    const u = DATA.groups.filter(g => a[g.id] === "?").map(g => g.name);
    const blank = DATA.groups.filter(g => !a[g.id]).length;
    L.push("・" + c.name + "：可用 " + (y.length ? y.join("、") : "無")
      + (u.length ? "｜待確認 " + u.join("、") : "")
      + (blank ? "｜未填 " + blank + " 題" : ""));
  });
  const ex = Object.keys(A.item);
  L.push("");
  L.push("■ 單獨設定的品項（" + ex.length + " 樣）");
  if (!ex.length) L.push("・無");
  ex.forEach(code => {
    let nm = code;
    DATA.cats.forEach(c => c.items.forEach(i => { if (i.code === code) nm = i.name; }));
    const y = DATA.groups.filter(g => A.item[code][g.id] === "y").map(g => g.name);
    L.push("・[" + code + "] " + nm + "：" + (y.length ? y.join("、") : "全部不適用"));
  });
  L.push("");
  L.push("■ 金額");
  DATA.money.forEach(m => L.push("・" + m.name + "：" + (A.money[m.code] === "" || A.money[m.code] == null ? "（不提供／未填）" : A.money[m.code] + " 元")));
  L.push("");
  L.push("■ 註記說明");
  DATA.ask.forEach(q => L.push("・" + q.name + "：" + (A.ask[q.code] || "（未填）")));
  L.push("");
  L.push("■ 相似註記");
  DATA.same.forEach((p,i) => L.push("・" + p.a + " / " + p.b + "：" +
    (A.same[i] === "merge" ? "合併" : A.same[i] === "keep" ? "都保留" : A.same[i] === "?" ? "待確認" : "（未填）")));
  if (A.note.trim()) { L.push(""); L.push("■ 老闆補充"); L.push(A.note.trim()); }
  L.push("");
  L.push("（下面這行是系統用的，請一起貼上，不用理它）");
  L.push(code());
  return L.join("\n");
}

function download(name, text, type){
  const blob = new Blob([text], {type: type || "application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = name; a.click();
  setTimeout(() => URL.revokeObjectURL(url), 2000);
}

function renderDone(){
  let unfilled = 0;
  DATA.cats.forEach(c => DATA.groups.forEach(g => { if (!(A.cat[c.name]||{})[g.id]) unfilled++; }));
  view.insertAdjacentHTML("beforeend", `
    <div class="done"><div class="stamp">填寫完成</div></div>
    ${unfilled ? `<div class="hint">還有 ${unfilled} 題沒選，可以按「上一頁」回去補；先傳出來也可以，我們再一起看。</div>` : ""}
    <div class="card"><h3>把結果傳回來</h3>
      <p class="egs">按下面存成檔案，用 LINE 或 email 傳回來就好。若還要再改，之後從第一頁「接續上次的進度」讀回這個檔案。</p>
    </div>`);
  const card = document.createElement("div");
  card.className = "card";
  [["存成檔案（傳這個給我們）", () => download("文章牛肉湯_選項確認_" + new Date().toISOString().slice(0,10) + ".json",
      JSON.stringify({shop:"文章牛肉湯", filledAt:new Date().toISOString(), answers:A, summary:summary()}, null, 2))],
   ["存成文字檔（自己留存）", () => download("文章牛肉湯_選項確認.txt", summary(), "text/plain;charset=utf-8")],
   ["複製文字，貼到 LINE", () => {
      const t = summary();
      const showBox = () => {
        const box = document.getElementById("copybox");
        const ta = document.getElementById("copytext");
        ta.value = t; box.style.display = "flex"; ta.focus(); ta.select();
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(t).then(() => alert("已複製，貼到 LINE 傳給我們就好。"), showBox);
      } else showBox();
   }],
   ["清除全部重填", () => {
      if (confirm("確定要清掉全部答案、從頭重填嗎？")) {
        try { localStorage.removeItem(KEY); } catch(e){}
        location.reload();
      }
   }]].forEach(([label, fn]) => {
      const b = document.createElement("button");
      b.className = "btn next"; b.style.width = "100%"; b.style.margin = "8px 0";
      b.textContent = label; b.onclick = fn;
      card.appendChild(b);
   });
  view.appendChild(card);
  const pre = document.createElement("div");
  pre.className = "card";
  pre.innerHTML = `<h3>填寫內容預覽</h3><pre style="white-space:pre-wrap;font-family:inherit;font-size:16px;color:var(--muted);margin:0">${esc(summary())}</pre>`;
  view.appendChild(pre);
}

document.getElementById("next").onclick = () => { if (step < steps.length - 1) { step++; save(); render(); } };
document.getElementById("prev").onclick = () => { if (step > 0) { step--; save(); render(); } };
document.getElementById("copyclose").onclick = () => { document.getElementById("copybox").style.display = "none"; };
window.addEventListener("pagehide", save);
document.addEventListener("visibilitychange", save);
step = restore();
render();
</script>
