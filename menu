<meta charset="utf-8">
<meta name="robots" content="noindex,nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>文章牛肉湯｜點餐選項確認單</title>
<style>
  :root{
    --ink:#241713;          /* 醬油色 */
    --paper:#F7F2E8;        /* 單據紙 */
    --card:#FFFDF8;
    --line:#D9CDB8;
    --scallion:#3F7A2E;     /* 蔥綠 = 可以 */
    --chili:#BE3A2B;        /* 辣椒紅 = 不行 */
    --broth:#B8862F;        /* 清湯金 = 重點 */
    --muted:#7A6A5C;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:"PingFang TC","Microsoft JhengHei","Noto Sans TC","Heiti TC",sans-serif;
    font-size:18px; line-height:1.7;
    -webkit-text-size-adjust:100%;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 16px 160px}

  /* 單據抬頭 */
  header{
    background:var(--ink); color:var(--paper);
    padding:18px 16px 16px; text-align:center;
    border-bottom:6px double #4a352c;
  }
  header .shop{font-size:26px;font-weight:800;letter-spacing:.18em}
  header .tag{font-size:14px;letter-spacing:.28em;color:#C9B79E;margin-top:4px}

  .bar{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--line);padding:10px 16px}
  .bar .row{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;font-size:15px;color:var(--muted)}
  .track{flex:1;height:10px;background:#E7DCC8;border-radius:99px;overflow:hidden}
  .fill{height:100%;width:0;background:var(--broth);transition:width .3s}

  h2{font-size:25px;font-weight:800;margin:26px 0 4px;letter-spacing:.02em}
  .lead{color:var(--muted);font-size:16px;margin:0 0 18px}

  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin:14px 0;
        box-shadow:0 1px 0 #fff inset}
  .card h3{margin:0 0 2px;font-size:20px;font-weight:800}
  .egs{color:var(--muted);font-size:15px;margin:0 0 12px}

  /* 品項小票 */
  .ticket{background:var(--card);border:1px dashed var(--line);border-radius:12px;padding:14px 16px;margin:8px 0 20px}
  .ticket .cap{font-size:14px;letter-spacing:.2em;color:var(--broth);font-weight:700}
  .ticket .list{font-size:16px;color:var(--muted);margin-top:4px}

  .choices{display:flex;gap:10px}
  .choices button{
    flex:1;min-height:58px;font-size:19px;font-weight:700;cursor:pointer;
    border:2px solid var(--line);background:#fff;color:var(--ink);border-radius:11px;
    font-family:inherit;transition:.12s;
  }
  .choices button:active{transform:scale(.98)}
  .choices button[data-v="y"].on{background:var(--scallion);border-color:var(--scallion);color:#fff}
  .choices button[data-v="n"].on{background:var(--chili);border-color:var(--chili);color:#fff}
  .choices button[data-v="?"].on{background:var(--muted);border-color:var(--muted);color:#fff}
  button:focus-visible{outline:3px solid var(--broth);outline-offset:2px}

  .nav{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);
       padding:12px 16px calc(12px + env(safe-area-inset-bottom));
       box-shadow:0 -4px 14px rgba(36,23,19,.07)}
  .nav .row{max-width:760px;margin:0 auto;display:flex;gap:12px}
  .btn{flex:1;min-height:56px;border-radius:11px;font-size:19px;font-weight:800;font-family:inherit;cursor:pointer;border:2px solid var(--ink)}
  .btn.prev{background:#fff;color:var(--ink);flex:0 0 34%}
  .btn.next{background:var(--ink);color:var(--paper)}
  .btn:disabled{opacity:.35;cursor:default}

  input[type=text],input[type=number],textarea{
    width:100%;font-family:inherit;font-size:18px;padding:12px;border:2px solid var(--line);
    border-radius:10px;background:#fff;color:var(--ink)}
  textarea{min-height:88px;resize:vertical}
  label.small{font-size:15px;color:var(--muted)}

  .money{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px dotted var(--line)}
  .money:last-child{border-bottom:0}
  .money .nm{flex:1;font-size:19px;font-weight:700}
  .money input{width:110px;text-align:right;font-variant-numeric:tabular-nums}
  .money .yuan{color:var(--muted)}

  .catbtn{width:100%;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:12px;
          padding:16px;font-size:19px;font-weight:700;font-family:inherit;cursor:pointer;margin:8px 0;color:var(--ink)}
  .itemrow{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px dotted var(--line)}
  .itemrow .nm{flex:1;font-size:18px}
  .toggle{min-width:104px;min-height:44px;border-radius:9px;border:2px solid var(--line);background:#fff;
          font-family:inherit;font-size:16px;font-weight:700;cursor:pointer;color:var(--muted)}
  .toggle.on{background:var(--broth);border-color:var(--broth);color:#fff}
  .sub{margin:8px 0 16px;padding:12px;background:#FBF6EC;border-radius:10px}
  .sub .q{font-size:17px;font-weight:700;margin:10px 0 6px}

  .hint{background:#FBF6EC;border-left:5px solid var(--broth);padding:12px 14px;border-radius:0 10px 10px 0;font-size:16px}
  .done{text-align:center;padding:20px 0}
  .done .stamp{display:inline-block;border:3px solid var(--chili);color:var(--chili);border-radius:12px;
    padding:8px 20px;font-size:22px;font-weight:800;letter-spacing:.2em;transform:rotate(-4deg);margin-bottom:14px}
  .file{display:block;margin:10px 0;font-size:16px;color:var(--muted)}
  .warn{background:#FFF4D6;border-bottom:2px solid var(--broth);padding:12px 16px;font-size:16px;text-align:center;display:none}
  .saved{font-size:14px;color:var(--muted)}
  .copybox{position:fixed;inset:0;background:rgba(36,23,19,.94);z-index:50;display:none;flex-direction:column;padding:18px;gap:12px}
  .copybox p{color:var(--paper);margin:0;font-size:17px}
  .copybox textarea{flex:1;font-size:15px;min-height:0}
  .copybox .btn{flex:0 0 auto}
  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header>
  <div class="shop">文章牛肉湯</div>
