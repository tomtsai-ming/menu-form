/* 自動存檔：手機切走再回來、不小心關掉都不會白填。存在這支手機的瀏覽器裡。 */
const KEY = "wenzhang_beef_v1";
function save(){ try { localStorage.setItem(KEY, JSON.stringify({A:A, step:step})); } catch(e){} }
function restore(){
  try {
    const d = JSON.parse(localStorage.getItem(KEY) || "null");
    if (d && d.A) { Object.assign(A, d.A); return d.step || 0; }
  } catch(e){}
  return 0;
}
